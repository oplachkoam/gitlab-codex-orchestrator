# HTTP
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# GitLab
# Use one Project Access Token (or PAT) with scopes: api + write_repository.
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Optional identity for autonomous git commits.
GIT_AUTHOR_NAME=Codex Orchestrator
GIT_AUTHOR_EMAIL=codex-orchestrator@localhost

# Workflow labels
TRIGGER_LABEL=ai::ready
ANALYZING_LABEL=ai::analyzing
WAITING_LABEL=ai::waiting
RESUME_LABEL=ai::resume
DONE_LABEL=ai::done
ERROR_LABEL=ai::error

# Codex CLI
# Authentication is NOT configured here. Run `codex login --device-auth`
# once against the persistent /data volume; see README.md.
# Model/sandbox/reasoning are configured in codex-config.toml at image build time.
CODEX_TIMEOUT_SECONDS=1800

# Runtime
DATA_DIR=/data
MAX_WORKERS=2
# 0 = full clone. Set e.g. 50 for shallow history.
GIT_DEPTH=0
