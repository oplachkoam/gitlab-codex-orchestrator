{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["needs_input", "complete"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "analysis": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": ["status", "summary", "analysis", "questions"],
  "additionalProperties": false
}
